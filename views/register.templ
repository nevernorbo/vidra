package views

// Register is the sign-up form for an invite token; invalid replaces the form with an explanation.
templ Register(token, username, errMsg string, invalid bool) {
	<div class="mx-auto max-w-sm pt-8 sm:pt-16">
		<h1 class="page-title">Create your account</h1>
		if invalid {
			<p class="alert mt-8">This invite is invalid, used or expired. Ask for a new one.</p>
		} else {
			<form method="post" action="/register" class="mt-8 space-y-4">
				if errMsg != "" {
					<p class="alert">{ errMsg }</p>
				}
				<input type="hidden" name="token" value={ token }/>
				<div class="field">
					<input
						id="u"
						name="username"
						value={ username }
						class="input peer"
						placeholder=" "
						autocomplete="username"
						autocapitalize="none"
						required
						autofocus
					/>
					<label class="float-label" for="u">Username</label>
				</div>
				<div>
					<div class="field">
						<input
							id="p"
							name="password"
							type="password"
							minlength="8"
							maxlength="72"
							class="input peer"
							placeholder=" "
							autocomplete="new-password"
							required
							aria-describedby="p-hint"
						/>
						<label class="float-label" for="p">Password</label>
					</div>
					<p id="p-hint" class="mt-2 px-4 text-xs text-muted">At least 8 characters</p>
				</div>
				<button class="btn btn-primary btn-lg !mt-6">Create account</button>
			</form>
		}
	</div>
}
