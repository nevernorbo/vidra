package views

// InviteHead is the link preview Discord and others show for an invite. by may be empty if the inviter is gone.
templ InviteHead(by string, expiresAt int64, url, image string) {
	<meta property="og:site_name" content="vidra"/>
	<meta property="og:type" content="website"/>
	<meta property="og:title" content={ inviteTitle(by) }/>
	<meta property="og:description" content={ "Create an account to upload videos and share them with a link. This invite works once and expires in " + duration(expiresAt) + "." }/>
	<meta property="og:url" content={ url }/>
	<meta property="og:image" content={ image }/>
	<meta property="og:image:alt" content="vidra logo"/>
	<meta name="twitter:card" content="summary"/>
}

func inviteTitle(by string) string {
	if by == "" {
		return "You’re invited to vidra"
	}
	return by + " invited you to vidra"
}

// Register is the sign-up form for an invite token; invalid replaces the form with an explanation.
templ Register(token, username, errMsg string, invalid bool) {
	<div class="mx-auto max-w-sm pt-8 sm:pt-16">
		<h1 class="page-title">Create your account</h1>
		if invalid {
			<p class="alert mt-8">This invite is invalid, used or expired. Ask for a new one.</p>
		} else {
			<form method="post" action="/register" class="mt-8 space-y-4">
				if errMsg != "" {
					<p class="alert">{ errMsg }</p>
				}
				<input type="hidden" name="token" value={ token }/>
				<div class="field">
					<input
						id="u"
						name="username"
						value={ username }
						class="input peer"
						placeholder=" "
						autocomplete="username"
						autocapitalize="none"
						required
						autofocus
					/>
					<label class="float-label" for="u">Username</label>
				</div>
				<div>
					<div class="field">
						<input
							id="p"
							name="password"
							type="password"
							minlength="8"
							maxlength="72"
							class="input peer"
							placeholder=" "
							autocomplete="new-password"
							required
							aria-describedby="p-hint"
						/>
						<label class="float-label" for="p">Password</label>
					</div>
					<p id="p-hint" class="mt-2 px-4 text-xs text-muted">At least 8 characters</p>
				</div>
				<button class="btn btn-primary btn-lg !mt-6">Create account</button>
			</form>
		}
	</div>
}
