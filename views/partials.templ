package views

import "fmt"

// icon draws a 24×24 line icon. class adds sizing or positioning on top of the base "ico" style.
templ icon(name, class string) {
	<svg viewBox="0 0 24 24" class={ "ico", templ.KV(class, class != "") } aria-hidden="true">
		switch name {
			case "user":
				<circle cx="12" cy="8" r="4"></circle>
				<path d="M4 21a8 8 0 0116 0"></path>
			case "calendar":
				<rect x="3" y="5" width="18" height="16" rx="2"></rect>
				<path d="M3 10h18M8 3v4M16 3v4"></path>
			case "file":
				<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"></path>
				<path d="M14 3v5h5"></path>
			case "clock":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 7v5l3 2"></path>
			case "mail":
				<path d="M4 7l8 6 8-6M4 6h16v12H4z"></path>
			case "link":
				<path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"></path>
			case "more":
				<circle cx="5" cy="12" r="1"></circle>
				<circle cx="12" cy="12" r="1"></circle>
				<circle cx="19" cy="12" r="1"></circle>
			case "close":
				<path d="M6 6l12 12M18 6L6 18"></path>
			case "download":
				<path d="M12 4v12m0 0l-5-5m5 5l5-5M4 20h16"></path>
			case "upload":
				<path d="M12 16V4m0 0L7 9m5-5l5 5M4 16v3a1 1 0 001 1h14a1 1 0 001-1v-3"></path>
			case "eye":
				<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>
				<circle cx="12" cy="12" r="3"></circle>
			case "eye-off":
				<path d="M3 3l18 18M10.6 5.1A9.8 9.8 0 0112 5c6.5 0 10 7 10 7a17 17 0 01-2.7 3.6M6.6 6.6C3.9 8.3 2 12 2 12s3.5 7 10 7a9.7 9.7 0 005.4-1.6M9.9 9.9a3 3 0 004.2 4.2"></path>
			case "trash":
				<path d="M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 002 2h8a2 2 0 002-2l1-12M9 7V4h6v3"></path>
			case "sliders":
				<path d="M4 7h9M17 7h3M4 17h3M11 17h9"></path>
				<circle cx="15" cy="7" r="2"></circle>
				<circle cx="9" cy="17" r="2"></circle>
			case "pencil":
				<path d="M4 20h4L19 9a2.8 2.8 0 00-4-4L4 16z"></path>
				<path d="M13.5 6.5l4 4"></path>
			case "logout":
				<path d="M15 4h3a2 2 0 012 2v12a2 2 0 01-2 2h-3M10 17l-5-5 5-5M5 12h11"></path>
		}
	</svg>
}

templ videoMeta(v *Video) {
	<ul class="flex flex-wrap items-center gap-x-3.5 gap-y-1 text-muted">
		if v.By != "" {
			<li class="flex items-center gap-1.5" title="Uploaded by">
				@icon("user", "h-[1.15em] w-[1.15em]")
				{ v.By }
			</li>
		}
		<li class="flex items-center gap-1.5" title="Uploaded">
			@icon("calendar", "h-[1.15em] w-[1.15em]")
			{ fmtDate(v.CreatedAt) }
		</li>
		if v.Size != 0 {
			<li class="flex items-center gap-1.5" title="File size">
				@icon("file", "h-[1.15em] w-[1.15em]")
				{ FormatBytes(v.Size) }
			</li>
		}
		<li class="flex items-center gap-1.5">
			@icon("clock", "h-[1.15em] w-[1.15em]")
			{ fmtExpires(v.ExpiresAt) }
		</li>
	</ul>
}

// UsageMeter shows storage used against the quota. With OOB set, htmx swaps it in place from any response.
templ UsageMeter(u Usage) {
	<div
		id="usage"
		if u.OOB {
			hx-swap-oob="true"
		}
		class="flex items-center gap-3 text-xs text-muted"
	>
		<div
			class="h-1 flex-1 overflow-hidden rounded-full bg-line"
			role="progressbar"
			aria-label="Storage used"
			aria-valuenow={ u.Pct }
			aria-valuemin="0"
			aria-valuemax="100"
		>
			<div
				class={ "h-full rounded-full", templ.KV("bg-danger", u.Pct >= 90), templ.KV("bg-amber", u.Pct < 90) }
				style={ fmt.Sprintf("width: %d%%", u.Pct) }
			></div>
		</div>
		<span class="shrink-0 tabular-nums"><span class="text-fg">{ FormatBytes(u.Used) }</span> of { FormatBytes(u.Quota) }</span>
	</div>
}

// VideoCard is one tile in the library. Shared videos (By set) have no details dialog.
templ VideoCard(v *Video) {
	<article
		id={ "v-" + v.ID }
		class="group min-w-0"
		if v.Status == "processing" {
			hx-get={ "/videos/" + v.ID + "/card" }
			hx-trigger="every 3s[!this.querySelector('dialog[open]')]"
			hx-swap="outerHTML"
		}
	>
		<a href={ "/v/" + v.ID } class="relative block aspect-video overflow-hidden rounded-xl bg-panel ring-1 ring-inset ring-line">
			switch v.Status {
				case "ready":
					<img src={ "/v/" + v.ID + "/thumb.jpg" } alt="" loading="lazy" class="h-full w-full object-cover"/>
				case "processing":
					<span class="absolute inset-0 grid place-items-center text-sm text-muted">
						<span class="flex items-center gap-2">
							<span class="h-4 w-4 animate-spin rounded-full border-2 border-line border-t-amber"></span>
							Processing
						</span>
					</span>
				default:
					<span class="absolute inset-0 grid place-items-center text-sm text-danger">Processing failed</span>
			}
			if v.Visibility != "public" {
				<span class="absolute left-2 top-2 rounded-md bg-ink/80 px-1.5 py-0.5 text-[11px] font-medium text-fg backdrop-blur">Private</span>
			}
		</a>
		<div class="mt-3 flex items-start gap-2">
			<a href={ "/v/" + v.ID } class="min-w-0 flex-1 truncate font-display text-[15px] font-medium text-fg hover:text-amber" title={ v.Title }>
				{ v.Title }
			</a>
			<div class="-mr-1.5 -mt-1 flex shrink-0">
				// v.ID is a server-generated UUID, so it is safe inside the JS string
				<button class="icon-btn" onclick={ templ.JSUnsafeFuncCall("copyText(location.origin+'/v/" + v.ID + "')") } title="Copy link" aria-label="Copy link">
					@icon("link", "")
				</button>
				if v.By == "" {
					<button
						class="icon-btn"
						onclick="this.closest('article').querySelector('dialog').showModal()"
						title="Details"
						aria-label="Details"
						aria-haspopup="dialog"
					>
						@icon("more", "")
					</button>
				}
			</div>
		</div>
		<div class="mt-1 text-[13px]">
			@videoMeta(v)
		</div>
		if v.By == "" {
			<dialog
				aria-labelledby={ "d-" + v.ID }
				class="w-[calc(100%-2rem)] max-w-sm rounded-2xl bg-panel text-fg shadow-2xl shadow-black/50 ring-1 ring-line
					backdrop:bg-ink/70 backdrop:backdrop-blur-sm"
				onclick="if (event.target === this) this.close()"
			>
				<div class="p-5">
					<div class="flex items-center justify-between">
						<h2 id={ "d-" + v.ID } class="font-display text-xl font-bold tracking-tight">Details</h2>
						<button class="icon-btn -mr-1.5" onclick="this.closest('dialog').close()" aria-label="Close">
							@icon("close", "")
						</button>
					</div>
					<form class="mt-4 flex gap-2" hx-post={ "/videos/" + v.ID + "/title" } hx-target={ "#v-" + v.ID } hx-swap="outerHTML">
						<div class="field min-w-0 flex-1">
							<input
								id={ "t-" + v.ID }
								name="title"
								value={ v.Title }
								maxlength="100"
								required
								class="input peer bg-ink"
								placeholder=" "
								autocomplete="off"
							/>
							<label class="float-label" for={ "t-" + v.ID }>Title</label>
						</div>
						<button class="btn btn-primary h-14 rounded-xl px-4">Rename</button>
					</form>
					<div class="mt-3 text-[13px]">
						@videoMeta(v)
					</div>
					<div class="-mx-2 mt-4 border-t border-line pt-2">
						if v.Status == "ready" {
							<a class="menu-item" href={ "/v/" + v.ID + "/video.mp4?download" } download>
								@icon("download", "")
								Download
							</a>
						}
						<button class="menu-item" hx-post={ "/videos/" + v.ID + "/visibility" } hx-target={ "#v-" + v.ID } hx-swap="outerHTML">
							if v.Visibility == "public" {
								@icon("eye-off", "")
								<span>
									Make private
									<span class="block text-xs text-muted">Currently anyone with the link can watch</span>
								</span>
							} else {
								@icon("eye", "")
								<span>
									Make public
									<span class="block text-xs text-muted">Currently only you can watch</span>
								</span>
							}
						</button>
						<button
							class="menu-item text-danger hover:!bg-danger/15"
							hx-delete={ "/videos/" + v.ID }
							hx-confirm={ "Delete “" + v.Title + "” permanently?" }
							hx-target={ "#v-" + v.ID }
							hx-swap="outerHTML"
						>
							@icon("trash", "")
							Delete
						</button>
					</div>
				</div>
			</dialog>
		}
	</article>
}

// InviteList shows the admin's recent invites; base is the public origin the links point at.
templ InviteList(invites []Invite, base string) {
	if len(invites) == 0 {
		<p class="py-6 text-center text-sm text-muted">No invites yet.</p>
	}
	<ul class="divide-y divide-line">
		for _, i := range invites {
			<li class="flex items-center gap-4 py-4">
				<div class="min-w-0 flex-1">
					<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
						if i.Active {
							<span class="badge bg-amber/15 text-amber">Active</span>
							<span class="flex items-center gap-1.5">
								@icon("clock", "")
								{ fmtExpires(i.ExpiresAt) }
							</span>
						} else if i.UsedBy.Valid {
							<span class="badge bg-line text-fg">Used</span>
							<span class="flex items-center gap-1.5">
								@icon("user", "")
								{ i.UsedBy.String }
							</span>
						} else {
							<span class="badge bg-line">Expired</span>
						}
					</div>
					if i.Active {
						<code class="mt-2 block truncate text-xs text-muted">{ base + "/register?token=" + i.Token }</code>
					}
				</div>
				if i.Active {
					<button
						class="btn h-9 shrink-0 px-3.5"
						onclick="copyText(this.dataset.url, 'Invite link copied')"
						data-url={ base + "/register?token=" + i.Token }
					>
						@icon("link", "")
						Copy
					</button>
				}
			</li>
		}
	</ul>
}

// MemberList shows everyone who joined with an invite. me is the viewing admin, who can't change their own role.
templ MemberList(members []Member, me int64) {
	<ul id="members" class="divide-y divide-line">
		for _, m := range members {
			<li class="flex items-center gap-4 py-4">
				<div class="min-w-0 flex-1">
					<p class="truncate text-[15px] font-medium text-fg">
						{ m.Name }
						if m.ID == me {
							<span class="font-normal text-muted">(you)</span>
						}
					</p>
					<p class="mt-1 flex flex-wrap items-center gap-x-3.5 gap-y-1 text-[13px] text-muted">
						<span class="flex items-center gap-1.5" title="Joined">
							@icon("calendar", "h-[1.15em] w-[1.15em]")
							{ fmtDate(m.JoinedAt) }
						</span>
						if m.By != "" {
							<span class="flex items-center gap-1.5">
								@icon("mail", "h-[1.15em] w-[1.15em]")
								Invited by { m.By }
							</span>
						}
					</p>
				</div>
				if m.ID == me {
					<span class="badge bg-line text-fg" title="You can’t change your own role">
						if m.Role == "admin" {
							Admin
						} else {
							User
						}
					</span>
				} else {
					<select
						name="role"
						class="select-sm shrink-0"
						aria-label={ "Role for " + m.Name }
						hx-post={ fmt.Sprintf("/settings/users/%d/role", m.ID) }
						hx-trigger="change"
						hx-target="#members"
						hx-swap="outerHTML"
					>
						<option value="user" selected?={ m.Role == "user" }>User</option>
						<option value="admin" selected?={ m.Role == "admin" }>Admin</option>
					</select>
				}
			</li>
		}
		if len(members) == 0 {
			<li class="py-6 text-sm text-muted">No one has joined yet. Send them an invite link.</li>
		}
	</ul>
}
