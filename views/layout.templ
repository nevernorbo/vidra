package views

// Layout wraps every full page. title names the tab and picks the active nav link; stylesheet is the
// versioned app.css URL; head is extra <head> content (nil for none).
templ Layout(title string, user *User, stylesheet string, head templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="color-scheme" content="dark"/>
			<meta name="theme-color" content="#15121A"/>
			<title>{ docTitle(title) }</title>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23F4B740'/%3E%3Cpath d='M12 9l12 7-12 7z' fill='%2315121A'/%3E%3C/svg%3E"/>
			if head != nil {
				@head
			}
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Instrument+Sans:wght@400;500;600&display=swap"/>
			<link rel="stylesheet" href={ stylesheet }/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		</head>
		<body class="min-h-screen bg-ink font-sans text-fg antialiased">
			<header class="sticky top-0 z-10 bg-ink/85 backdrop-blur-md">
				<nav class="mx-auto flex h-16 max-w-5xl items-center gap-0.5 px-4 text-sm sm:gap-1">
					<a href="/" class="mr-auto flex items-center gap-2 font-display text-2xl font-extrabold tracking-[-0.04em] text-fg">
						<svg viewBox="0 0 24 24" class="h-5 w-5 fill-amber"><path d="M7 4.5v15l12.5-7.5z"></path></svg>
						<span class="max-[400px]:sr-only">vidra</span>
					</a>
					if user != nil {
						<a
							href="/upload"
							class="nav-link"
							if title == "Upload" {
								aria-current="page"
							}
						>Upload</a>
						<a
							href="/videos"
							class="nav-link"
							if title == "Library" {
								aria-current="page"
							}
						>Library</a>
						if user.IsAdmin() {
							<a
								href="/settings"
								class="nav-link"
								if title == "Settings" {
									aria-current="page"
								}
							>Invites</a>
						}
						<form method="post" action="/logout" class="sm:ml-1">
							<button class="icon-btn" title={ "Log out (" + user.Name + ")" } aria-label="Log out">
								@icon("logout", "")
							</button>
						</form>
					} else if title != "Log in" {
						<a href="/login" class="nav-link">Log in</a>
					}
				</nav>
			</header>
			<main class="mx-auto max-w-5xl px-4 pb-[max(2.5rem,env(safe-area-inset-bottom))] pt-6 sm:pt-10">
				{ children... }
			</main>
			<div class="pointer-events-none fixed inset-x-0 bottom-[max(1.5rem,env(safe-area-inset-bottom))] z-20 flex justify-center px-4">
				<p
					id="toast"
					role="status"
					aria-live="polite"
					class="flex max-w-md translate-y-3 items-center gap-2 rounded-full bg-fg px-4 py-2.5 text-sm font-medium text-ink
						opacity-0 shadow-lg shadow-black/40 transition duration-200 motion-reduce:transition-none"
				></p>
			</div>
			<script>
				function toast(msg, error) {
					const t = document.getElementById('toast')
					t.textContent = msg
					t.classList.toggle('!bg-danger', !!error)
					t.classList.remove('opacity-0', 'translate-y-3')
					clearTimeout(t.timer)
					t.timer = setTimeout(() => t.classList.add('opacity-0', 'translate-y-3'), 2500)
				}
				async function copyText(t, msg = 'Link copied') {
					let ok = true
					try { await navigator.clipboard.writeText(t) } catch {
						const a = document.createElement('textarea'); a.value = t; document.body.append(a); a.select(); ok = document.execCommand('copy'); a.remove()
					}
					toast(ok ? msg : 'Couldn’t copy the link', !ok)
					return ok
				}
				document.body.addEventListener('toast', e => toast(e.detail.value))
				document.body.addEventListener('htmx:responseError', e => {
					const x = e.detail.xhr
					toast(x.status === 404 ? 'That video no longer exists. Reload the page.' : x.status < 500 && x.responseText.trim() || 'Something went wrong. Try again.', true)
				})
				document.body.addEventListener('htmx:sendError', () => toast('Can’t reach the server. Check your connection.', true))
				// a page that navigates away can leave a message for the next one in the URL hash
				const carried = { copied: 'Link copied', deleted: 'Video deleted' }[location.hash.slice(1)]
				if (carried) { history.replaceState(null, '', location.pathname + location.search); toast(carried) }
			</script>
		</body>
	</html>
}

func docTitle(title string) string {
	if title == "" {
		return "vidra"
	}
	return title + " · vidra"
}
