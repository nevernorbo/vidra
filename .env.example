# cp .env.example .env, fill it in, then: docker compose up -d --build

# First account, only used while the database has no users (remove afterwards if you like)
VIDRA_ADMIN_USER=admin
VIDRA_ADMIN_PASSWORD=change-me-please

# Public origin used in Discord/Open Graph URLs (no trailing slash)
VIDRA_BASE_URL=https://vidra.example.com

# Optional overrides (defaults shown)
# DATA_DIR=/opt/homelab/data      # videos and the SQLite DB end up in $DATA_DIR/vidra
# VIDRA_PORT=8086
# PUID=1000
# PGID=1000
# TZ=UTC
